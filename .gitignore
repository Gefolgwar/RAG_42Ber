# ==============================================================================
# 42 School: RAG against the machine - .gitignore
# ==============================================================================

# Raw corpus & attachments
vllm-0.10.1/

# Project Generated Data & Outputs (keep directories via .gitkeep)
data/processed/*
!data/processed/.gitkeep
data/output/*
!data/output/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Model Weights & Caches
models/
hf_cache/
.cache/
*.bin
*.pt
*.pth
*.safetensors
*.onnx

# Python Bytecode & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/

# Virtual Environments
.venv/
venv/
env/

# Linters, Type Checkers & Testing Caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage

# AI
.claude/
CLAUDE.md

# OS & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Evaluation
eval/

# Mulinette
moulinette/